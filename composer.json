{
    "name": "uams-web/uamswp-per-site-wayfinding",
    "description": "Serves unique robots.txt, llms.txt, and llms-full.txt per WordPress multisite subsite. Development dependencies only; nothing here is installed into production.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/Support/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "pest",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "refactor": "rector",
        "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
        "test:refactor": "rector --dry-run",
        "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php",
        "pint": "pint",
        "test:pint": "pint --test"
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database.",
        "stan": "Run PHPStan.",
        "refactor": "Apply the Rector gating profile.",
        "refactor:sweep": "Apply the Rector sweep profile (deliberate, reviewed).",
        "test:refactor": "Preview the Rector gating profile.",
        "test:refactor:sweep": "Preview the Rector sweep profile.",
        "pint": "Format with Pint.",
        "test:pint": "Check formatting with Pint."
    }
}
